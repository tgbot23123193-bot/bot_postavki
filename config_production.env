# WB Auto-Booking Bot Configuration

# TELEGRAM BOT CONFIGURATION (ОБЯЗАТЕЛЬНО!)
TG_BOT_TOKEN=ВСТАВЬТЕ_СЮДА_ВАШ_РЕАЛЬНЫЙ_ТОКЕН_ОТ_BOTFATHER
TG_WEBHOOK_URL=
TG_WEBHOOK_SECRET=
TG_ADMIN_IDS=

# DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:KulZLGinDnnRgWXgAWOmagjVMLLQRmoG@gondola.proxy.rlwy.net:24819/railway
DATABASE_ECHO=false

# REDIS CONFIGURATION (Опционально - если нет Redis, будет использоваться память)
REDIS_URL=redis://localhost:6379/0
REDIS_ENCODING=utf-8
REDIS_DECODE_RESPONSES=true

# SECURITY CONFIGURATION (ОБЯЗАТЕЛЬНО!)
SECURITY_ENCRYPTION_KEY=your_32_character_encryption_key_here_ok
SECURITY_JWT_SECRET=your_jwt_secret_key_here_also_ok

# REDISTRIBUTION CONFIGURATION
# Максимум попыток (0 = бесконечно) ♾️
REDISTRIBUTION_MAX_ATTEMPTS=0
# Интервал попыток вне активного периода (в СЕКУНДАХ) ⏱️
REDISTRIBUTION_RETRY_SECONDS=35
# Интервал попыток в активный период (в СЕКУНДАХ) 🔥⚡
REDISTRIBUTION_ACTIVE_RETRY_SECONDS=15
# Активные периоды (МСК): 8:55-9:10 и 9:55-10:10
REDISTRIBUTION_BOOKING_PERIODS=8:55-9:10,9:55-10:10
# Автоматический повтор при неудаче
REDISTRIBUTION_AUTO_RETRY=true

# APPLICATION CONFIGURATION
ENVIRONMENT=development
DEBUG=true

# LOGGING CONFIGURATION
LOG_LEVEL=INFO
LOG_FORMAT=json

# WILDBERRIES API CONFIGURATION
WB_BASE_URL=https://suppliers-api.wildberries.ru
WB_TIMEOUT=30
WB_MAX_RETRIES=3
WB_RATE_LIMIT_DELAY=60

# MONITORING CONFIGURATION
MONITORING_DEFAULT_INTERVAL_SEC=30
MONITORING_MAX_API_KEYS_PER_USER=5
MONITORING_TRIAL_BOOKINGS_LIMIT=2
